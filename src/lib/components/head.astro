---
import { SEO } from "astro-seo";
const { title, type, site, description, ogImage, locale, structuredData } = Astro.props;
const ogLocale = locale === "ar" ? "ar_EG" : "en_US";
import { Font } from "astro:assets";
const locales = ["ar", "en"];
const defaultLocale = "ar" as const;
const defaultOgImage = locale === "ar" ? "/og/default-ar.png" : "/og/default-en.png";
const currentPath = Astro.url.pathname;
let canonicalPath = currentPath;
for (const loc of locales) {
    if (currentPath.startsWith(`/${loc}/`)) {
        canonicalPath = currentPath.slice(`/${loc}`.length) || "/";
        break;
    }
    if (currentPath === `/${loc}`) {
        canonicalPath = "/";
        break;
    }
}
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta
    name="google-site-verification"
    content="4yiuf5PfM1oHFLmggZXuRU-0YEAo9s8A-KnK5PXktZM"
/>

<Font cssVariable="--font-vazirmatn" preload />
<Font cssVariable="--font-rokkitt" preload />
<Font cssVariable="--font-fira" preload />
<Font cssVariable="--font-cairo" preload />

<link rel="sitemap" href="/sitemap-index.xml" />

<link rel="alternate" hreflang="x-default" href={`${site}/${defaultLocale}${canonicalPath}`} />
{locales.map((loc) => (
    <link rel="alternate" hreflang={loc} href={`${site}/${loc}${canonicalPath}`} />
))}

{structuredData && (
    <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        ...structuredData,
    })} />
)}

<SEO
    title={title}
    description={description}
    canonical={site + Astro.url.pathname}
    openGraph={{
        basic: {
            title: title,
            type: type ?? "website",
            image: site + (ogImage ?? defaultOgImage),
            url: site + Astro.url.pathname,
        },
        optional: {
            description: description,
            siteName: "شناوي",
            locale: ogLocale,
        },
    }}
    twitter={{
        card: "summary_large_image",
        title: title,
        description: description,
        image: site + (ogImage ?? defaultOgImage),
    }}
/>
