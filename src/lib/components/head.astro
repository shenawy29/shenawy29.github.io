---
import { SEO } from "astro-seo";
const { title, type, site, description, ogImage, locale } = Astro.props;
const ogLocale = locale === "ar" ? "ar_EG" : "en_US";
import { Font } from "astro:assets";
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta
    name="google-site-verification"
    content="4yiuf5PfM1oHFLmggZXuRU-0YEAo9s8A-KnK5PXktZM"
/>

<Font cssVariable="--font-vazirmatn" preload />
<Font cssVariable="--font-rokkitt" preload />
<Font cssVariable="--font-fira" preload />
<Font cssVariable="--font-cairo" preload />

<link rel="sitemap" href="/sitemap-index.xml" />

<SEO
    title={title}
    description={description}
    canonical={site + Astro.url.pathname}
    openGraph={{
        basic: {
            title: title,
            type: type ?? "website",
            image: site + (ogImage ?? "/og/default-ar.png"),
            url: site + Astro.url.pathname,
        },
        optional: {
            description: description,
            siteName: "شناوي",
            locale: ogLocale,
        },
    }}
    twitter={{
        card: "summary_large_image",
        title: title,
        description: description,
        image: site + (ogImage ?? "/og/default-ar.png"),
    }}
/>
