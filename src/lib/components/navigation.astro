---
import {
    useTranslations,
    getLocalizedPath,
    getAlternateLocalePath,
} from "$lib/i18n/utils";
const { locale } = Astro.props;
const t = useTranslations(locale);
const currentPath = Astro.url.pathname;
const altPath = getAlternateLocalePath(currentPath, locale);
const isActive = (segment: string) =>
    currentPath === `/${locale}` ||
    new RegExp(`^/${locale}/${segment}(/|$)`).test(currentPath);
const active = {
    home:
        currentPath.replace(/\/$/, "") === `/${locale}` || currentPath === "/",
    syllabus: isActive("syllabus"),
    about: isActive("about"),
    tags: isActive("tags"),
};
---

<aside
    id="default-sidebar"
    class={`${locale === "ar" ? "lg:right-0" : "lg:left-0"} hidden lg:fixed lg:inset-y-0 lg:block`}
    aria-label="Sidebar"
>
    <div
        class="flex h-full w-72 flex-col justify-end gap-y-6 overflow-y-auto bg-sumi-ink1 p-8 text-old-white"
    >
        <div>
            <h1 class="text-6xl leading-none text-[#C34043]">
                <a
                    href={getLocalizedPath("/", locale)}
                    class="hover:text-[#E06060]"
                    >{t("site.title")}</a
                >
            </h1>
            <p class="text-xm mt-5 leading-relaxed text-old-white/70">
                {t("site.description")}
            </p>
        </div>

        <hr class="border-old-white/20" />

        <nav class="flex flex-wrap items-center gap-x-2">
            <a
                href={getLocalizedPath("/", locale)}
                class={`${active.home ? "font-semibold text-[#C34043]" : "text-old-white/80 hover:text-spring-green hover:underline hover:decoration-spring-green"}`}
            >
                {t("nav.home")}
            </a>
            <span class="text-old-white/40">•</span>
            <a
                href="https://drive.google.com/file/d/1Z166OXTG-p3laaaV1cmjP9T91GG3_R_e/view?usp=sharing"
                class="text-old-white/80 hover:text-spring-green hover:underline hover:decoration-spring-green"
            >
                {t("nav.cv")}
            </a>
            <span class="text-old-white/40">•</span>
            <a
                href={getLocalizedPath("/syllabus", locale)}
                class={`${active.syllabus ? "font-semibold text-[#C34043]" : "text-old-white/80 hover:text-spring-green hover:underline hover:decoration-spring-green"}`}
            >
                {t("nav.syllabus")}
            </a>
            <span class="text-old-white/40">•</span>
            <a
                href={getLocalizedPath("/about", locale)}
                class={`${active.about ? "font-semibold text-[#C34043]" : "text-old-white/80 hover:text-spring-green hover:underline hover:decoration-spring-green"}`}
            >
                {t("nav.about")}
            </a>

            <span class="text-old-white/40">•</span>
            <a
                href={getLocalizedPath("/tags", locale)}
                class={`${active.tags ? "font-semibold text-[#C34043]" : "text-old-white/80 hover:text-spring-green hover:underline hover:decoration-spring-green"}`}
            >
                {t("nav.tags")}
            </a>
            <span class="text-old-white/40">•</span>
            <a
                aria-label="GitHub"
                href="https://github.com/shenawy29/"
                class="px-2"
            >
                <svg
                    class="h-4 w-4"
                    viewBox="0 0 100 100"
                    xmlns="http://www.w3.org/2000/svg"
                    ><path
                        fill-rule="evenodd"
                        clip-rule="evenodd"
                        d="M48.854 0C21.839 0 0 22 0 49.217c0 21.756 13.993 40.172 33.405 46.69 2.427.49 3.316-1.059 3.316-2.362 0-1.141-.08-5.052-.08-9.127-13.59 2.934-16.42-5.867-16.42-5.867-2.184-5.704-5.42-7.17-5.42-7.17-4.448-3.015.324-3.015.324-3.015 4.934.326 7.523 5.052 7.523 5.052 4.367 7.496 11.404 5.378 14.235 4.074.404-3.178 1.699-5.378 3.074-6.6-10.839-1.141-22.243-5.378-22.243-24.283 0-5.378 1.94-9.778 5.014-13.2-.485-1.222-2.184-6.275.486-13.038 0 0 4.125-1.304 13.426 5.052a46.97 46.97 0 0 1 12.214-1.63c4.125 0 8.33.571 12.213 1.63 9.302-6.356 13.427-5.052 13.427-5.052 2.67 6.763.97 11.816.485 13.038 3.155 3.422 5.015 7.822 5.015 13.2 0 18.905-11.404 23.06-22.324 24.283 1.78 1.548 3.316 4.481 3.316 9.126 0 6.6-.08 11.897-.08 13.526 0 1.304.89 2.853 3.316 2.364 19.412-6.52 33.405-24.935 33.405-46.691C97.707 22 75.788 0 48.854 0z"
                        fill="#c8c093"></path></svg
                >
            </a>
            <span class="text-old-white/40">•</span>
            <a
                aria-label="RSS Feed"
                href={getLocalizedPath("/rss.xml", locale)}
                class="px-2"
            >
                <svg
                    class="h-4 w-4"
                    fill="#c8c093"
                    version="1.1"
                    viewBox="-271 273 256 256"
                    xml:space="preserve"
                    xmlns="http://www.w3.org/2000/svg"
                >
                    <path
                        d="m-271 360v48.9c31.9 0 62.1 12.6 84.7 35.2s35.1 52.8 35.1 84.8v0.1h49.1c0-46.6-19-88.7-49.6-119.4-30.5-30.6-72.7-49.5-119.3-49.6z"
                    ></path>
                    <path
                        d="m-237 460.9c-9.4 0-17.8 3.8-24 10s-10 14.6-10 24c0 9.3 3.8 17.7 10 23.9 6.2 6.1 14.6 9.9 24 9.9s17.8-3.7 24-9.9 10-14.6 10-23.9c0-9.4-3.8-17.8-10-24s-14.6-10-24-10z"
                    ></path>
                    <path
                        d="m-90.1 348.1c-46.3-46.4-110.2-75.1-180.8-75.1v48.9c114.1 0.1 206.8 93 206.9 207.1h49c0-70.6-28.7-134.5-75.1-180.9z"
                    ></path>
                </svg>
            </a>
            <span class="text-old-white/40">•</span>
            <a
                href={altPath}
                class="text-old-white/80 hover:text-spring-green hover:underline hover:decoration-spring-green"
            >
                {t("lang_switch")}
            </a>
        </nav>

        <span class="text-sm leading-relaxed text-old-white/50">
            © {new Date().getFullYear() + " " + t("footer.attribution")}
            <span class="mt-1 flex items-center gap-x-2 text-[0.95em]">
                <a
                    href="https://creativecommons.org/licenses/by-sa/4.0/legalcode"
                    class="hover:text-spring-green hover:underline hover:decoration-spring-green"
                    >CC BY-SA</a
                >
                <span class="text-old-white/40">•</span>
                <a
                    href="https://cloud.umami.is/share/gF1LivyFH5ztEuK7"
                    class="hover:text-spring-green hover:underline hover:decoration-spring-green"
                    >{t("footer.analytics")}</a
                >
            </span>
        </span>
    </div>
</aside>

<nav
    class="mx-auto block w-full max-w-full bg-sumi-ink1 p-6 text-center text-lg wrap-anywhere lg:hidden"
>
    <div>
        <a
            href={getLocalizedPath("/", locale)}
            class="hover:text-spring-green"
        >
            <span
                class="font-display text-[3rem] leading-tight font-bold text-[#C34043] hover:text-[#E06060]"
            >
                {t("site.title")}
            </span>
        </a>
        <p class="mt-4 text-sm leading-relaxed text-old-white/70">
            {t("site.description")}
        </p>
    </div>

    <div class="mt-2 flex flex-col">
        <nav
            class="flex flex-wrap items-center justify-center gap-x-2 leading-relaxed"
        >
            <a
                href={getLocalizedPath("/", locale)}
                class={`hover:text-spring-green hover:underline hover:decoration-spring-green ${active.home ? "font-semibold text-[#C34043]" : "text-old-white/80"}`}
                >{t("nav.home")}</a
            >
            <span class="text-old-white/40">•</span>
            <a
                href="https://drive.google.com/file/d/1Z166OXTG-p3laaaV1cmjP9T91GG3_R_e/view?usp=sharing"
                class="text-old-white/80 hover:text-spring-green hover:underline hover:decoration-spring-green"
                >{t("nav.cv")}</a
            >
            <span class="text-old-white/40">•</span>
            <a
                href={getLocalizedPath("/syllabus", locale)}
                class={`hover:text-spring-green hover:underline hover:decoration-spring-green ${active.syllabus ? "font-semibold text-[#C34043]" : "text-old-white/80"}`}
                >{t("nav.syllabus")}</a
            >
            <span class="text-old-white/40">•</span>
            <a
                href={getLocalizedPath("/about", locale)}
                class={`hover:text-spring-green hover:underline hover:decoration-spring-green ${active.about ? "font-semibold text-[#C34043]" : "text-old-white/80"}`}
                >{t("nav.about")}</a
            >
        </nav>
        <nav
            class="mt-1 flex flex-wrap items-center justify-center gap-x-2 leading-relaxed"
        >
            <a
                href={getLocalizedPath("/tags", locale)}
                class={`hover:text-spring-green hover:underline hover:decoration-spring-green ${active.tags ? "font-semibold text-[#C34043]" : "text-old-white/80"}`}
                >{t("nav.tags")}</a
            >
            <span class="text-old-white/40">•</span>
            <a
                aria-label="GitHub"
                href="https://github.com/shenawy29/"
                class="text-old-white/80 hover:text-spring-green"
            >
                <svg
                    class="inline h-5 w-5 align-middle"
                    viewBox="0 0 100 100"
                    xmlns="http://www.w3.org/2000/svg"
                >
                    <path
                        fill-rule="evenodd"
                        clip-rule="evenodd"
                        d="M48.854 0C21.839 0 0 22 0 49.217c0 21.756 13.993 40.172 33.405 46.69 2.427.49 3.316-1.059 3.316-2.362 0-1.141-.08-5.052-.08-9.127-13.59 2.934-16.42-5.867-16.42-5.867-2.184-5.704-5.42-7.17-5.42-7.17-4.448-3.015.324-3.015.324-3.015 4.934.326 7.523 5.052 7.523 5.052 4.367 7.496 11.404 5.378 14.235 4.074.404-3.178 1.699-5.378 3.074-6.6-10.839-1.141-22.243-5.378-22.243-24.283 0-5.378 1.94-9.778 5.014-13.2-.485-1.222-2.184-6.275.486-13.038 0 0 4.125-1.304 13.426 5.052a46.97 46.97 0 0 1 12.214-1.63c4.125 0 8.33.571 12.213 1.63 9.302-6.356 13.427-5.052 13.427-5.052 2.67 6.763.97 11.816.485 13.038 3.155 3.422 5.015 7.822 5.015 13.2 0 18.905-11.404 23.06-22.324 24.283 1.78 1.548 3.316 4.481 3.316 9.126 0 6.6-.08 11.897-.08 13.526 0 1.304.89 2.853 3.316 2.364 19.412-6.52 33.405-24.935 33.405-46.691C97.707 22 75.788 0 48.854 0z"
                        fill="#c8c093"></path>
                </svg>
            </a>
            <span class="text-old-white/40">•</span>
            <a
                aria-label="RSS Feed"
                href={getLocalizedPath("/rss.xml", locale)}
                class="text-old-white/80 hover:text-spring-green"
            >
                <svg
                    fill="#c8c093"
                    version="1.1"
                    viewBox="-271 273 256 256"
                    xml:space="preserve"
                    xmlns="http://www.w3.org/2000/svg"
                    class="inline h-4 w-4 align-middle"
                >
                    <path
                        d="m-271 360v48.9c31.9 0 62.1 12.6 84.7 35.2s35.1 52.8 35.1 84.8v0.1h49.1c0-46.6-19-88.7-49.6-119.4-30.5-30.6-72.7-49.5-119.3-49.6z"
                    ></path>
                    <path
                        d="m-237 460.9c-9.4 0-17.8 3.8-24 10s-10 14.6-10 24c0 9.3 3.8 17.7 10 23.9 6.2 6.1 14.6 9.9 24 9.9s17.8-3.7 24-9.9 10-14.6 10-23.9c0-9.4-3.8-17.8-10-24s-14.6-10-24-10z"
                    ></path>
                    <path
                        d="m-90.1 348.1c-46.3-46.4-110.2-75.1-180.8-75.1v48.9c114.1 0.1 206.8 93 206.9 207.1h49c0-70.6-28.7-134.5-75.1-180.9z"
                    ></path>
                </svg>
            </a>
            <span class="text-old-white/40">•</span>
            <a
                href={altPath}
                class="text-old-white/80 hover:text-spring-green hover:underline hover:decoration-spring-green"
                >{t("lang_switch")}</a
            >
        </nav>
    </div>

    <span class="block items-center text-sm leading-relaxed text-old-white/50">
        <br />
        <div class="flex justify-center gap-x-2">
            <span>
                © {new Date().getFullYear() + " " + t("footer.attribution")}
            </span>

            <span class="text-old-white/40">•</span>
            <a
                href="https://creativecommons.org/licenses/by-sa/4.0/legalcode"
                class="hover:text-spring-green hover:underline hover:decoration-spring-green"
                >CC BY-SA</a
            >
            <span class="text-old-white/40">•</span>
            <a
                href="https://cloud.umami.is/share/gF1LivyFH5ztEuK7"
                class="hover:text-spring-green hover:underline hover:decoration-spring-green"
            >
                {t("footer.analytics")}</a
            >
        </div>
    </span>
</nav>
