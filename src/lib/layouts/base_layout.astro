---
import "$lib/styles/global.css";
import Navigation from "$lib/components/navigation.astro";
import Head from "$lib/components/head.astro";
import { getLocale, useTranslations } from "$lib/i18n/utils";

const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale);

const siteTitle = t("site.title");
const siteDescription = t("site.description");

const title = Astro.props?.title
    ? Astro.props.title + " · " + siteTitle
    : Astro.props?.frontmatter?.title
      ? Astro.props.frontmatter.title + " · " + siteTitle
      : siteTitle;

const ogTitle =
    Astro.props?.ogTitle ??
    Astro.props?.title ??
    Astro.props?.frontmatter?.title ??
    siteTitle;

const description =
    Astro.props?.description ??
    Astro.props?.frontmatter?.description ??
    siteDescription;

const ogImage = Astro.props?.ogImage ?? Astro.props?.frontmatter?.ogImage;
const type = Astro.props?.type ?? Astro.props?.frontmatter?.type;
const structuredData =
    Astro.props?.structuredData ?? Astro.props?.frontmatter?.structuredData;
const publishedTime =
    Astro.props?.publishedTime ?? Astro.props?.frontmatter?.publishedTime;
const modifiedTime =
    Astro.props?.modifiedTime ?? Astro.props?.frontmatter?.modifiedTime;
const tags = Astro.props?.tags ?? Astro.props?.frontmatter?.tags;
const articleSection =
    Astro.props?.articleSection ?? Astro.props?.frontmatter?.articleSection;
const authors = Astro.props?.authors ?? Astro.props?.frontmatter?.authors;
const noindex = Astro.props?.noindex ?? Astro.props?.frontmatter?.noindex;
const canonical =
    Astro.props?.canonical ?? Astro.props?.frontmatter?.canonical;

const site = Astro.url.origin;
const htmlDir = locale === "ar" ? "rtl" : "ltr";
const mainDir = locale === "ar" ? "rtl" : "ltr";
const htmlLang = locale === "ar" ? "ar" : "en";
const sidebarMargin = locale === "ar" ? "lg:mr-72" : "lg:ml-72";
---

<html lang={htmlLang} dir={htmlDir} class="w-full">
    <head>
        <Head
            title={title}
            ogTitle={ogTitle}
            description={description}
            type={type}
            site={site}
            ogImage={ogImage}
            locale={locale}
            structuredData={structuredData}
            publishedTime={publishedTime}
            modifiedTime={modifiedTime}
            tags={tags}
            articleSection={articleSection}
            authors={authors}
            noindex={noindex}
            canonical={canonical}
        />
        <script
            defer
            is:inline
            src="/count.js"
            data-website-id="03adab5c-e6d1-4a05-bbfe-fcf69f36e716"></script>
    </head>

    <body class="w-full overflow-y-scroll bg-sumi-ink2 text-old-white">
        <div class="flex w-full flex-col lg:flex-row lg:items-center">
            <Navigation locale={locale} />
            <main
                dir={mainDir}
                class={`prose ml-0 flex flex-col p-8 font-write prose-kanagawa md:max-w-240 lg:prose-lg ${sidebarMargin} lg:p-16 lg:text-lg prose-p:mt-0 prose-p:mb-5 prose-a:hover:decoration-spring-green prose-kbd:bg-sumi-ink1 prose-code:bg-sumi-ink1`}
            >
                <slot />
            </main>
        </div>
    </body>
</html>
