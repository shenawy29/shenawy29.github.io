---
import BaseLayout from "$lib/layouts/base_layout.astro";
import Posts from "$lib/components/posts.astro";
import { websiteData, personData } from "$lib/i18n/structured-data";
const sd = [
    websiteData(
        "ar",
        "شناوي",
        "بلوج محمد الشناوي للبرمجة، التكنولوجيا، وأشياء طريفة أخرى.",
    ),
    personData(),
];
---

<BaseLayout ogImage="/og/ar/index.png" structuredData={sd}>
    <Posts locale="ar" />
</BaseLayout>
