---
import PostHeader from "$lib/components/post-header.astro";
import BaseLayout from "$lib/layouts/base_layout.astro";
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import { getEntry } from "astro:content";
import { getCollection } from "astro:content";
import { blogPostingData } from "$lib/i18n/structured-data";

export const getStaticPaths = (async () => {
    const posts = await getCollection("posts-en");

    return posts.map((p) => ({
        params: {
            post: `${p.data.pubDate.toISOString().substring(0, 10)}/${p.id}/`,
        },
        props: { locale: "en" },
    }));
}) satisfies GetStaticPaths;

const { locale } = Astro.props;
const { post } = Astro.params;
let slug = post.split("/")[1];
const postEntry = await getEntry("posts-en", slug)!;
const { Content } = await render(postEntry);
const sd = blogPostingData(
    locale,
    postEntry.data.title,
    postEntry.data.description,
    `/og/${locale}/${slug}.png`,
    Astro.url.pathname,
    postEntry.data.pubDate,
    postEntry.data.pubDate,
    postEntry.data.tags,
);
---

<BaseLayout
    title={postEntry.data.title}
    ogImage={`/og/en/${slug}.png`}
    description={postEntry.data.description}
    type="article"
    structuredData={sd}
>
    <div>
        <PostHeader post={postEntry} locale={locale} />
    </div>
    <div class="leading-8 lg:pr-5">
        <Content />
    </div>
</BaseLayout>
