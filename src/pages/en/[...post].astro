---
import PostHeader from "$lib/components/post-header.astro";
import BaseLayout from "$lib/layouts/base_layout.astro";
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import { getEntry } from "astro:content";
import { getCollection } from "astro:content";
import { useTranslations, type Locale } from "$lib/i18n/utils";
import {
    blogPostingData,
    breadcrumbData,
    personData,
    websiteData,
} from "$lib/i18n/structured-data";

const site = "https://shenawy29.github.io";

export const getStaticPaths = (async () => {
    const posts = await getCollection("posts-en");

    return posts.map((p) => ({
        params: {
            post: `${p.data.pubDate.toISOString().substring(0, 10)}/${p.id}/`,
        },
        props: { locale: "en" },
    }));
}) satisfies GetStaticPaths;

const { locale } = Astro.props;
const { post } = Astro.params;
let slug = post.split("/")[1];
const postEntry = await getEntry("posts-en", slug)!;
const { Content, remarkPluginFrontmatter } = await render(postEntry);
const lastModified = remarkPluginFrontmatter.lastModified
    ? new Date(remarkPluginFrontmatter.lastModified) : undefined;
const description = remarkPluginFrontmatter.excerpt;
const t = useTranslations(locale as Locale);
const wordCount = (postEntry.body ?? "").trim().split(/\s+/).length;
const sd = [
    websiteData(locale, t("site.title"), t("site.description")),
    personData(),
    blogPostingData(
        locale,
        postEntry.data.title,
        description,
        `/og/${locale}/${slug}.png`,
        Astro.url.pathname,
        postEntry.data.pubDate,
        lastModified,
        postEntry.data.keywords ?? postEntry.data.tags,
        postEntry.data.tags[0],
        wordCount,
    ),
    breadcrumbData(locale, [
        { name: t("site.title"), url: `/${locale}/` },
        { name: postEntry.data.title, url: Astro.url.pathname },
    ]),
];
const publishedTime = postEntry.data.pubDate.toISOString();
const modifiedTime = (lastModified ?? postEntry.data.pubDate).toISOString();
---

<BaseLayout
    title={postEntry.data.title}
    ogImage={`/og/en/${slug}.png`}
    description={description}
    type="article"
    structuredData={sd}
    publishedTime={publishedTime}
    modifiedTime={modifiedTime}
    tags={postEntry.data.tags}
    articleSection={postEntry.data.tags[0]}
    authors={[site]}
>
    <div>
        <PostHeader post={postEntry} locale={locale} />
    </div>
    <div class="text-xl leading-9 lg:pr-5">
        <Content />
    </div>
</BaseLayout>
