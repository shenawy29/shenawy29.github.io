---
import BaseLayout from "$lib/layouts/base_layout.astro";
import { getCollection } from "astro:content";
import { getLocale } from "$lib/i18n/utils";
import { collectionPageData } from "$lib/i18n/structured-data";

const locale = getLocale(Astro.url.pathname);
const collectionName = locale === "ar" ? "posts-ar" : "posts-en";
const sd = collectionPageData(locale, "Tags", Astro.url.pathname);

const pages = await getCollection(collectionName);

const tagMap = new Map<string, typeof pages>();

for (const page of pages) {
    for (const tag of page.data.tags) {
        const list = tagMap.get(tag);
        if (list) {
            list.push(page);
        } else {
            tagMap.set(tag, [page]);
        }
    }
}

for (const [tag, posts] of tagMap) {
    tagMap.set(
        tag,
        posts.sort(
            (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
        ),
    );
}

const uniqueTags = [...tagMap.keys()].sort((a, b) => a.localeCompare(b));
---

<BaseLayout title={locale === "ar" ? "تاجژ" : "Tags"} ogImage="/og/default-en.png" structuredData={sd}>
    <div class="page-title">
        <h1>
            <a href="#tags">{locale === "ar" ? "تاجژ" : "Tags"}</a>
        </h1>
    </div>
    {
        uniqueTags.map((tag) => (
            <div>
                <h2 id={tag} class="section-heading">
                    <a href={`#${tag}`}>
                        <span>#{tag}</span>
                    </a>
                </h2>
                <ul class="tag-list prose-p:m-0 prose-li:m-0">
                    {tagMap.get(tag)!.map((post) => (
                        <li>
                            <p>
                                <span class="opacity-60">
                                    {post.data.pubDate
                                        .toISOString()
                                        .substring(0, 10)
                                        .trim() + "\\"}
                                </span>

                                <a
                                    href={`/${locale}/${post.data.pubDate.toISOString().substring(0, 10)}/${post.id}`}
                                >
                                    <span>{post.data.title}</span>
                                </a>
                            </p>
                        </li>
                    ))}
                </ul>
            </div>
        ))
    }
</BaseLayout>
