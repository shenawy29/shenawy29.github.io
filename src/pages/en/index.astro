---
import BaseLayout from "$lib/layouts/base_layout.astro";
import Posts from "$lib/components/posts.astro";
import { websiteData, personData } from "$lib/i18n/structured-data";
const sd = [
    websiteData(
        "en",
        "Shenawy",
        "Mohamed Elshenawy's blog for programming, tech, and other fun things.",
    ),
    personData(),
];
---

<BaseLayout ogImage="/og/en/index.png" structuredData={sd}>
    <Posts locale="en" />
</BaseLayout>
